# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Admin/Logging
ADMIN=your_admin_id
LOG_CHANNEL=-100xxxxxxxxxx
SUPPORT_GROUP=-100xxxxxxxxxx

# Database
MONGO_DB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Download Settings
DOWNLOAD_DIR=/tmp/downloads
MAX_DOWNLOAD_SIZE=4294967296

# Repository Updates (Optional)
UPSTREAM_REPO=https://github.com/yourfork/Auto-Anime-Bot
UPSTREAM_BRANCH=main

# Other Settings
ON_HEROKU=False
PORT=8080
